{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/commands/*.md)",
      "Edit(docs/protocol/BASELINE.md)",
      "Write(AGENTS.md)",
      "Write(CLAUDE.md)",
      "Write(.claude/settings.json)",
      "Write(.claude/commands/*.md)",
      "Write(docs/protocol/BASELINE.md)"
    ]
  }
}
